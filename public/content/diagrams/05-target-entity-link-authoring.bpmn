    <bpmn:sequenceFlow id="Flow_08" sourceRef="link" targetRef="stage" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="stage" targetRef="validate" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="validate" targetRef="valid" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="valid" targetRef="correct" name="No" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="correct" targetRef="edit" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="valid" targetRef="commit" name="Yes" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="commit" targetRef="delete" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="delete" targetRef="impact" name="Yes" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="impact" targetRef="stage" name="Approved safe change" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="delete" targetRef="save" name="No" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="save" targetRef="end" />
  </bpmn:process>
