  <bpmn:process id="Process_05_target_entity_link_authoring" name="TARGET — Strict entity, container, collection, and link authoring" isExecutable="false">
    <bpmn:documentation>Status: TARGET_MOSTLY_IMPLEMENTED_TUI_SHARED_PARTIAL. Source basis: Full STEMMA editing contract; TUI demos/audits; FamilyHistoryData.pdf sections 6.4–6.12; shared mutation lifecycle.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_05_target_entity_link_authoring">
      <bpmn:lane id="Lane_Process_05_target_entity_link_authoring_User" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_05_target_entity_link_authoring_Frontend" name="Frontend">
        <bpmn:flowNodeRef>root</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>container</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>impact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_05_target_entity_link_authoring_Application" name="Application">
        <bpmn:flowNodeRef>stage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_05_target_entity_link_authoring_STEMMA___persistence" name="STEMMA / persistence">
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Choose Dataset and construct" />
    <bpmn:exclusiveGateway id="kind" name="Person, Event, Place, Group, Animal, Source, Citation, Resource, Matrix, Narrative, Contact, Text, or container?" />
    <bpmn:task id="root" name="Create/open strict entity or support root" />
    <bpmn:task id="container" name="Open Document/Dataset-owned container" />
    <bpmn:task id="edit" name="Edit scalar, controlled value, date, or metadata" />
    <bpmn:task id="collection" name="Add, edit, reorder, or delete collection item" />
    <bpmn:task id="link" name="Choose typed link target in correct Dataset scope" />
    <bpmn:task id="stage" name="Stage candidate change set" />
    <bpmn:task id="validate" name="Validate shape, key, scope, references, and dates" />
    <bpmn:exclusiveGateway id="valid" name="Candidate valid?" />
    <bpmn:task id="correct" name="Show exact field/path and preserve prior state" />
    <bpmn:task id="commit" name="Commit in-memory transaction and mark dirty" />
    <bpmn:exclusiveGateway id="delete" name="Delete or rename affects references?" />
    <bpmn:task id="impact" name="Show impact; retarget or reject safely" />
    <bpmn:task id="save" name="Save through shared persistence lifecycle" />
    <bpmn:endEvent id="end" name="Updated construct remains navigable" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="kind" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="kind" targetRef="root" name="Entity/support root" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="kind" targetRef="container" name="Document/Dataset container" />
