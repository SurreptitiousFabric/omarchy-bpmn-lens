  <bpmn:process id="Process_10_target_web_experience" name="TARGET — Web experience over shared application workflows" isExecutable="false">
    <bpmn:documentation>Status: TARGET_WEB_NOT_IMPLEMENTED. Source basis: Plan 4 channel-neutral architecture and GUI assessment; current web adapter is verified absent. This is an adapter design target, not a claim of existing web behavior or a STEMMA-mandated research process.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_10_target_web_experience">
      <bpmn:lane id="Lane_Process_10_target_web_experience_User" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_10_target_web_experience_Frontend" name="Frontend">
        <bpmn:flowNodeRef>session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>state</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>author</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_10_target_web_experience_Application" name="Application">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_10_target_web_experience_STEMMA___persistence" name="STEMMA / persistence">
        <bpmn:flowNodeRef>persist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Open web application" />
    <bpmn:task id="session" name="Establish authorized session and workspace scope" />
    <bpmn:task id="open" name="Invoke shared Document lifecycle" />
    <bpmn:task id="state" name="Render ready/degraded/validation/access state" />
    <bpmn:task id="browse" name="Browse responsive list/detail views" />
    <bpmn:task id="search" name="Filter, search, and follow semantic trails" />
    <bpmn:exclusiveGateway id="action" name="Inspect or author?" />
    <bpmn:task id="inspect" name="Render evidence, citation preview, Resource rights, and narrative" />
    <bpmn:task id="author" name="Use accessible forms, pickers, and structured editors" />
    <bpmn:task id="shared" name="Call the same validation and mutation use cases as TUI" />
    <bpmn:exclusiveGateway id="conflict" name="Baseline current and operation authorized?" />
    <bpmn:task id="reject" name="Show conflict/authorization/validation outcome; preserve draft" />
    <bpmn:task id="persist" name="Persist through shared safe lifecycle" />
    <bpmn:task id="result" name="Refresh qualified views and report exact outcome" />
    <bpmn:endEvent id="end" name="End or continue session" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="session" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="session" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="open" targetRef="state" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="state" targetRef="browse" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="browse" targetRef="search" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="search" targetRef="action" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="action" targetRef="inspect" name="Inspect" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="action" targetRef="author" name="Author" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="inspect" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="author" targetRef="shared" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="shared" targetRef="conflict" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="conflict" targetRef="reject" name="No" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="reject" targetRef="author" name="Correct/retry" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="conflict" targetRef="persist" name="Yes" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="persist" targetRef="result" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="result" targetRef="end" />
  </bpmn:process>
