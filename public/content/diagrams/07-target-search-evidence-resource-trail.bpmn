        <bpmn:flowNodeRef>resource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_07_target_search_evidence_resource_trail_STEMMA___persistence" name="STEMMA / persistence" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need to find or verify something" />
    <bpmn:exclusiveGateway id="mode" name="Choose filter, plain search, guided query, or semantic link" />
    <bpmn:task id="query" name="Execute bounded query in qualified context" />
    <bpmn:task id="results" name="Show typed, disambiguated results" />
    <bpmn:task id="choose" name="Select result" />
    <bpmn:task id="origin" name="Create origin token and derivation edge" />
    <bpmn:task id="open" name="Open exact entity, Text segment, finding, or evidence target" />
    <bpmn:task id="trail" name="Follow Source → Citation → Resource or reasoning trail" />
    <bpmn:exclusiveGateway id="resource" name="Resource requested?" />
    <bpmn:task id="rights" name="Resolve locator and rights/access outcome" />
    <bpmn:exclusiveGateway id="available" name="Available and permitted?" />
    <bpmn:task id="handoff" name="Safely hand off media/URI" />
    <bpmn:task id="unavailable" name="Explain unavailable/restricted result" />
    <bpmn:task id="return" name="Return using exact origin and preserved view state" />
    <bpmn:endEvent id="end" name="Continue research" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="mode" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="mode" targetRef="query" name="Filter/plain/guided" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="query" targetRef="results" />
