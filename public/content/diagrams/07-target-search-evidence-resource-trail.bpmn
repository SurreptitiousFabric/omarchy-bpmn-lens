  <bpmn:process id="Process_07_target_search_evidence_resource_trail" name="TARGET — Search, semantic navigation, evidence trail, and Resource handoff" isExecutable="false">
    <bpmn:documentation>Status: TARGET_PARTIAL. Source basis: TUI search contracts; Plan 4 GF-01; byhand evidence/preview and search targets; STEMMA narrative/detail links and Source trail semantics.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_07_target_search_evidence_resource_trail">
      <bpmn:lane id="Lane_Process_07_target_search_evidence_resource_trail_User" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_07_target_search_evidence_resource_trail_Frontend" name="Frontend">
        <bpmn:flowNodeRef>mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_07_target_search_evidence_resource_trail_Application" name="Application">
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>origin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_07_target_search_evidence_resource_trail_STEMMA___persistence" name="STEMMA / persistence" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need to find or verify something" />
    <bpmn:exclusiveGateway id="mode" name="Choose filter, plain search, guided query, or semantic link" />
    <bpmn:task id="query" name="Execute bounded query in qualified context" />
    <bpmn:task id="results" name="Show typed, disambiguated results" />
    <bpmn:task id="choose" name="Select result" />
    <bpmn:task id="origin" name="Create origin token and derivation edge" />
    <bpmn:task id="open" name="Open exact entity, Text segment, finding, or evidence target" />
    <bpmn:task id="trail" name="Follow Source → Citation → Resource or reasoning trail" />
    <bpmn:exclusiveGateway id="resource" name="Resource requested?" />
    <bpmn:task id="rights" name="Resolve locator and rights/access outcome" />
    <bpmn:exclusiveGateway id="available" name="Available and permitted?" />
    <bpmn:task id="handoff" name="Safely hand off media/URI" />
    <bpmn:task id="unavailable" name="Explain unavailable/restricted result" />
    <bpmn:task id="return" name="Return using exact origin and preserved view state" />
    <bpmn:endEvent id="end" name="Continue research" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="mode" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="mode" targetRef="query" name="Filter/plain/guided" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="query" targetRef="results" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="results" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="choose" targetRef="origin" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="mode" targetRef="origin" name="Semantic/detail link" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="origin" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="open" targetRef="trail" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="trail" targetRef="resource" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="resource" targetRef="return" name="No" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="resource" targetRef="rights" name="Yes" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="rights" targetRef="available" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="available" targetRef="handoff" name="Yes" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="available" targetRef="unavailable" name="No" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="handoff" targetRef="return" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="unavailable" targetRef="return" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="return" targetRef="end" />
  </bpmn:process>
