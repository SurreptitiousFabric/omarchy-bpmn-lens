  <bpmn:process id="Process_04_target_evidence_to_conclusion" name="TARGET — Evidence-first research from source material to conclusions" isExecutable="false">
    <bpmn:documentation>Status: TARGET_STEMMA_CORE. Source basis: FamilyHistoryData.pdf sections 2, 3, 6.3.1, and 6.9; current Source/Citation/Resource/Matrix editing contracts; byhand event-participant provenance target.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_04_target_evidence_to_conclusion">
      <bpmn:lane id="Lane_Process_04_target_evidence_to_conclusion_User" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frame</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transcribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correlate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_04_target_evidence_to_conclusion_Frontend" name="Frontend">
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>profiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_04_target_evidence_to_conclusion_Application" name="Application">
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_04_target_evidence_to_conclusion_STEMMA___persistence" name="STEMMA / persistence">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Encounter source material" />
    <bpmn:task id="describe" name="Describe Citation and Resource" />
    <bpmn:task id="source" name="Create or open Source / SourceLet" />
    <bpmn:task id="frame" name="Record frame: where, when, material links, quality" />
    <bpmn:task id="transcribe" name="Transcribe or extract source content" />
    <bpmn:task id="profiles" name="Model proto-subjects, dates, commentary, and properties" />
    <bpmn:task id="evidence" name="Attach documentary evidence to subject/event context" />
    <bpmn:task id="correlate" name="Compare and correlate evidence" />
    <bpmn:exclusiveGateway id="infer" name="Inference required?" />
    <bpmn:task id="reason" name="Record reasoning, inference, and surety in genealogical data" />
    <bpmn:task id="conclude" name="Create or revise conclusional entities and typed links" />
    <bpmn:task id="trail" name="Link conclusions back through reasoning and evidence" />
    <bpmn:task id="validate" name="Validate identity, reference, and provenance semantics" />
    <bpmn:exclusiveGateway id="ok" name="Valid?" />
    <bpmn:task id="repair" name="Return exact finding for correction" />
    <bpmn:task id="save" name="Persist evidence and conclusions without collapsing them" />
    <bpmn:endEvent id="end" name="Research trail available for review" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="describe" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="describe" targetRef="source" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="source" targetRef="frame" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="frame" targetRef="transcribe" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="transcribe" targetRef="profiles" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="profiles" targetRef="evidence" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="evidence" targetRef="correlate" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="correlate" targetRef="infer" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="infer" targetRef="reason" name="Yes" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="infer" targetRef="conclude" name="No" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="reason" targetRef="conclude" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="conclude" targetRef="trail" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="trail" targetRef="validate" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="validate" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ok" targetRef="repair" name="No" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="repair" targetRef="frame" name="Correct at source/model layer" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ok" targetRef="save" name="Yes" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="save" targetRef="end" />
  </bpmn:process>
