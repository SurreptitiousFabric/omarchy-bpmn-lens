      </bpmn:lane>
      <bpmn:lane id="Lane_Process_09_target_tui_experience_Frontend" name="Frontend">
        <bpmn:flowNodeRef>workspace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runtime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>author</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dirty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_09_target_tui_experience_Application" name="Application">
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_09_target_tui_experience_STEMMA___persistence" name="STEMMA / persistence" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Launch with keyboard" />
    <bpmn:task id="workspace" name="Use startup chooser or workspace file workbench" />
    <bpmn:task id="runtime" name="Enter responsive two-pane shell" />
    <bpmn:task id="navigate" name="Navigate, resize, focus, promote, and return" />
    <bpmn:task id="discover" name="Filter or search" />
    <bpmn:exclusiveGateway id="intent" name="Inspect or author?" />
    <bpmn:task id="inspect" name="Inspect detail, evidence, preview, and contextual help" />
    <bpmn:task id="author" name="Use scalar, choice, tri-state, vocabulary, relationship, list, or narrative editor" />
    <bpmn:task id="commit" name="Commit/cancel through deterministic message transition" />
    <bpmn:task id="dirty" name="Show dirty, validation, and failure state honestly" />
    <bpmn:task id="persist" name="Save, Save As, or Export XML" />
    <bpmn:task id="outcome" name="Show success or actionable recovery without losing edits" />
    <bpmn:exclusiveGateway id="more" name="Continue?" />
    <bpmn:endEvent id="end" name="Quit safely" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="workspace" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="workspace" targetRef="runtime" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="runtime" targetRef="navigate" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="navigate" targetRef="discover" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="discover" targetRef="intent" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="intent" targetRef="inspect" name="Inspect" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="intent" targetRef="author" name="Author" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="inspect" targetRef="more" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="author" targetRef="commit" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="commit" targetRef="dirty" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="dirty" targetRef="persist" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="persist" targetRef="outcome" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="outcome" targetRef="more" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="more" targetRef="navigate" name="Yes" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="more" targetRef="end" name="No" />
  </bpmn:process>
