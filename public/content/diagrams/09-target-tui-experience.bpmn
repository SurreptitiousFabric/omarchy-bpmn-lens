  <bpmn:process id="Process_09_target_tui_experience" name="TARGET — TUI experience orchestration" isExecutable="false">
    <bpmn:documentation>Status: TARGET_TUI_MIXED. Source basis: TUI master spec; expanded byhand WHAT-parity PAR-410–763; demo use-case map; Bubble Tea architecture contracts.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_09_target_tui_experience">
      <bpmn:lane id="Lane_Process_09_target_tui_experience_User" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>navigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discover</bpmn:flowNodeRef>
