    <bpmn:sequenceFlow id="Flow_08" sourceRef="choose" targetRef="create" name="Create" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="create" targetRef="create_ws" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="create_ws" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="valid" targetRef="open" name="Yes" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="open" targetRef="load" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="load" targetRef="browse" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="browse" targetRef="discover" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="discover" targetRef="select" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="select" targetRef="inspect" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="inspect" targetRef="back" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="back" targetRef="browse" name="Continue" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="back" targetRef="end" name="Quit" />
  </bpmn:process>
