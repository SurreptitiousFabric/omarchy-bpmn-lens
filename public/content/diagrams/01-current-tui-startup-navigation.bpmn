        <bpmn:flowNodeRef>load</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_01_current_tui_startup_navigation_STEMMA___persistence" name="STEMMA / persistence">
        <bpmn:flowNodeRef>create_ws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start TUI" />
    <bpmn:exclusiveGateway id="choose" name="Choose Open or Create" />
    <bpmn:task id="scan" name="Scan runtime root" />
    <bpmn:task id="pick" name="Pick candidate file" />
    <bpmn:task id="validate" name="Validate candidate" />
    <bpmn:exclusiveGateway id="valid" name="Candidate valid?" />
    <bpmn:task id="show_error" name="Show failure and recovery guidance" />
    <bpmn:task id="create" name="Enter new-file details" />
    <bpmn:task id="create_ws" name="Create workspace" />
    <bpmn:task id="open" name="Open selected workspace" />
    <bpmn:task id="load" name="Load runtime surface" />
    <bpmn:task id="browse" name="Browse Document, Dataset, and entities" />
    <bpmn:task id="discover" name="Filter table or run plain/guided search" />
    <bpmn:task id="select" name="Select qualified result" />
    <bpmn:task id="inspect" name="Inspect detail and contextual actions" />
    <bpmn:exclusiveGateway id="back" name="Return or continue browsing" />
    <bpmn:endEvent id="end" name="Leave TUI" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="choose" targetRef="scan" name="Open" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="scan" targetRef="pick" />
