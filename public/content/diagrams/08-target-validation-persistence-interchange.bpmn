    <bpmn:startEvent id="start" name="User requests save, save-as, export, import, or package" />
    <bpmn:exclusiveGateway id="operation" name="Select operation" />
    <bpmn:task id="validate" name="Run syntax, schema, semantic, and reference validation" />
    <bpmn:exclusiveGateway id="valid" name="Acceptable?" />
    <bpmn:task id="findings" name="Show stable findings; navigate and recheck" />
    <bpmn:task id="snapshot" name="Snapshot baseline and stage output" />
    <bpmn:task id="format" name="Preserve current format, Save As protobuf, or Export XML" />
    <bpmn:task id="write" name="Write temp, fsync, atomic replace, fsync directory" />
    <bpmn:task id="verify" name="Reopen and verify persisted result" />
    <bpmn:exclusiveGateway id="success" name="Verified?" />
    <bpmn:task id="recover" name="Restore/offer backup; retain dirty state" />
    <bpmn:task id="refresh" name="Refresh indexes and clear accepted change set" />
    <bpmn:task id="package" name="Include required Resources and manifest" />
    <bpmn:endEvent id="end" name="Report exact outcome and path" />
