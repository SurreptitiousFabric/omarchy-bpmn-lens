    <bpmn:sequenceFlow id="Flow_16" sourceRef="persist" targetRef="saved" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="saved" targetRef="refresh" name="Yes" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="saved" targetRef="retain" name="No" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="refresh" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="retain" targetRef="end" />
