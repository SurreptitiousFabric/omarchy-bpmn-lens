      <bpmn:lane id="Lane_Process_02_current_tui_edit_save_STEMMA___persistence" name="STEMMA / persistence">
        <bpmn:flowNodeRef>persist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Open an editable detail" />
    <bpmn:exclusiveGateway id="action" name="Choose scalar, choice, link, list, text, create, or delete action" />
    <bpmn:task id="editor" name="Open contextual editor or picker" />
    <bpmn:task id="stage" name="Stage typed mutation" />
    <bpmn:task id="cancel" name="Cancel without mutation" />
    <bpmn:task id="preflight" name="Validate key, value, link, scope, and references" />
    <bpmn:exclusiveGateway id="accepted" name="Mutation valid?" />
    <bpmn:task id="reject" name="Show error; retain prior state" />
    <bpmn:task id="dirty" name="Apply in memory and mark dirty" />
    <bpmn:exclusiveGateway id="more" name="Make more changes?" />
    <bpmn:task id="save" name="Request Save / Save As / Export XML" />
    <bpmn:task id="persist" name="Snapshot, apply, validate, atomic write" />
    <bpmn:exclusiveGateway id="saved" name="Persistence succeeded?" />
    <bpmn:task id="refresh" name="Reload surface/index; clear pending and dirty" />
    <bpmn:task id="retain" name="Keep dirty state and pending edits; show recovery" />
    <bpmn:endEvent id="end" name="Continue working" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="action" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="action" targetRef="editor" name="Edit/add/link/create" />
